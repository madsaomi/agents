# 📋 Шаблон окружения (nextjs). Скопируй в .env.local. НИКОГДА не коммить .env.local.

# --- Публичные (попадают в клиентский бандл — не клади сюда секретов!) ---
NEXT_PUBLIC_APP_NAME=nextjs-app
NEXT_PUBLIC_API_URL=http://localhost:3000

# --- Приватные (только сервер) ---
DATABASE_URL=postgresql://user:change-me@localhost:5432/app_db
AUTH_SECRET=change-me-to-a-long-random-string

# --- Внешние сервисы (пример) ---
# SENTRY_DSN=
# STRIPE_SECRET_KEY=
