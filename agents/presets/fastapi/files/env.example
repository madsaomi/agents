# 📋 Шаблон окружения (fastapi). Скопируй в .env. НИКОГДА не коммить .env.

APP_NAME=fastapi-app
APP_ENV=dev                # dev | prod
DEBUG=True

# --- Безопасность ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://app_user:change-me@localhost:5432/app_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Внешние сервисы (пример) ---
# SENTRY_DSN=
# OPENAI_API_KEY=
