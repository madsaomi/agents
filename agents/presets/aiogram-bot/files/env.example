# 📋 Шаблон окружения (aiogram-bot). Скопируй в .env. НИКОГДА не коммить .env.

# --- Telegram ---
BOT_TOKEN=123456789:replace-me-with-real-bot-token
BOT_ADMIN_IDS=123456789

# --- Режим работы ---
BOT_MODE=polling            # polling (dev) | webhook (prod)
WEBHOOK_HOST=https://example.com
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=change-me

# --- PostgreSQL ---
POSTGRES_DB=bot_db
POSTGRES_USER=bot_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://bot_user:change-me@localhost:5432/bot_db

# --- Redis (FSM + rate limit) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery (рассылки, фоновые задачи) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Внешние сервисы (пример) ---
# SENTRY_DSN=
# OPENAI_API_KEY=
